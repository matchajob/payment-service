{
  "name": "payment-service",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests,iac}/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"{src,tests,iac}/**/*.ts\" \"*.config.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsx watch src/api/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/cli/seed.ts",
    "outbox:redrive": "tsx --env-file=.env src/cli/redrive-outbox.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@matcha/infra": "github:leomerl/job-platform#8e4e985168c06d6d60aec1a007ee579e4aa0ec97&path:src/infra",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pulumi/gcp": "^10.1.1",
    "@pulumi/pulumi": "^3.268.0",
    "@types/node": "^22.15.18",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
