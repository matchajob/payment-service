{
  "permissions": {
    "deny": [
      "Edit(src/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-src.sh",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking src/ protection"
          }
        ]
      }
    ]
  }
}
