{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "paths": {
      "@/contract/*": ["../../src/contract/*"],
      "@sdk/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
